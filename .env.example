# Copy this file to .env.local and fill in real values.
# .env.local is gitignored, so real credentials never get committed.
#
# These power the quote form's email delivery (app/api/quote/route.ts).
# Any standard SMTP account works. Currently sending via Gmail:
#   1. Turn on 2-Step Verification: myaccount.google.com/security
#   2. Generate an app password: myaccount.google.com/apppasswords
#   3. Use that generated password below as SMTP_PASS (not your normal Google password)
#
# (Previously tried Yahoo — smtp.mail.yahoo.com — but that mailbox rejected
# authenticated SMTP sends with a "550 Mailbox unavailable" error, likely due
# to Yahoo restricting third-party SMTP clients on newly created accounts.
# Switched sending to an established Gmail account; delivery still lands in
# the novusconstruction@yahoo.ie inbox via CONTACT_TO_EMAIL below, since
# receiving there works fine — it was only outbound relay via Yahoo's own
# SMTP that failed.)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=vrussuleac@gmail.com
SMTP_PASS=your-app-password-here

# Where quote requests get delivered — can be a different address than SMTP_USER.
CONTACT_TO_EMAIL=novusconstruction@yahoo.ie
