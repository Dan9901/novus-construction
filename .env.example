# Copy this file to .env.local and fill in real values.
# .env.local is gitignored, so real credentials never get committed.
#
# These power the quote form's email delivery (app/api/quote/route.ts).
# Any standard SMTP account works. For Yahoo Mail:
#   1. Go to Yahoo Account Info -> Account Security -> Generate app password
#   2. Create an app password for "Mail" / "Other app"
#   3. Use that generated password below as SMTP_PASS (not your normal Yahoo password)

SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=novusconstruction@yahoo.ie
SMTP_PASS=your-app-password-here

# Where quote requests get delivered. Defaults to novusconstruction@yahoo.ie if omitted.
CONTACT_TO_EMAIL=novusconstruction@yahoo.ie
